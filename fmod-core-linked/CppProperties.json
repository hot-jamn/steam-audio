{
  "configurations": [
    {
      "inheritEnvironments": [
        "msvc_x86"
      ],
      "name": "x86-Debug",
      "includePath": [
        "${env.INCLUDE}",
        "${workspaceRoot}\\**"
      ],
      "defines": [
        "WIN32",
        "_DEBUG",
        "UNICODE",
        "_UNICODE"
      ],
      "intelliSenseMode": "windows-msvc-x86",
      "cmakeSettings": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "cmakeCommandArgs": "-DCMAKE_CXX_STANDARD=20"
    },
    {
      "inheritEnvironments": [
        "msvc_x64"
      ],
      "name": "x64-Debug",
      "includePath": [
        "${env.INCLUDE}",
        "${workspaceRoot}\\**"
      ],
      "defines": [
        "WIN32",
        "WIN64",
        "_DEBUG",
        "UNICODE",
        "_UNICODE"
      ],
      "intelliSenseMode": "windows-msvc-x64",
      "cmakeSettings": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "cmakeCommandArgs": "-DCMAKE_CXX_STANDARD=20"
    }
  ]
}